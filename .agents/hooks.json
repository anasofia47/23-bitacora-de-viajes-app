{
  "antigravity-security-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/security-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
